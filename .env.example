# REQUIRED = every runtime; SECRET = environment secret; ENVIRONMENT_SPECIFIC
# = deployment-owned; OPTIONAL = feature/provider opt-in; DERIVED = composed.
# Never commit populated secrets.
APP_NAME=Laravel
APP_ENV=local
# SECRET / REQUIRED
APP_KEY=
# Encryption |  Mã hóa 2 chiều
APP_DEBUG=false
# ENVIRONMENT_SPECIFIC / REQUIRED (HTTPS in production)
APP_URL=http://localhost

GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_LOGIN_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
PHONE_VERIFICATION_DRIVER=local
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

MEDIA_DRIVER=local
MEDIA_MAX_BYTES=8388608
CLOUDFLARE_IMAGES_TIMEOUT=15
# Production only: set an HTTPS origin and a distinct environment-owned database.
VPS_PRODUCTION_DATABASE=
DQ_STAGING_DATABASE=laraveldji_staging_restore

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# Nó liên quan tới Maintenance Mode: php artisan down  | Laravel cần nơi lưu trạng thái kiểu: Website có đang maintenance không? |  thì maintenance state dùng cache store tên database theo cấu hình của app.
# Nó không có nghĩa website đang maintenance. Chỉ là cấu hình nơi Laravel sẽ dùng khi bạn thực sự chạy:   php artisan down    |   php artisan up   để mở lại.

# PHP_CLI_SERVER_WORKERS=4
# Cái này dành cho local khi chạy:     php artisan serve    |  Nó giúp local dev xử lý nhiều reques
# Production VPS dùng Nginx + PHP-FPM thì biến này về cơ bản không phải cấu hình worker production.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production containers default to stderr only; add daily explicitly only when
# local file retention is intentionally owned and monitored.
LOG_PRODUCTION_STACK=stderr
LOG_DAILY_DAYS=14
ERROR_TRACKING_ENABLED=false
HEALTH_RATE_LIMIT=120
BACKUP_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=90

DB_CONNECTION=mysql
# ENVIRONMENT_SPECIFIC / REQUIRED
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schema_admin
DB_USERNAME=root
# SECRET / REQUIRED outside passwordless local development
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=


# TLS/HTTPS= cài trên VPS | Trước đó DNS của domain phải trỏ đúng IP VPS và Nginx phải có site cho domain:
#     +
# Secure Cookie=SESSION_SECURE_COOKIE=true | → Cookie chỉ gửi qua HTTPS 🔒
#     +
# HttpOnly=SESSION_HTTP_ONLY=true | → JavaScript không được đọc session cookie
#     +
# SameSite=SESSION_SAME_SITE=lax | → hạn chế gửi cookie trong cross-site context
# Secure Cookie= yêu cầu COOKIE chỉ đi trên HTTPS 🔒
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DRIVER=database
# bài 7.12 Session & Cookie Security
SESSION_SECURE_COOKIE=false
# → chỉ gửi cookie qua HTTPS

SESSION_HTTP_ONLY=true
# → JavaScript không đọc session cookie

SESSION_SAME_SITE=lax
# → hạn chế cookie trong cross-site context

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# Disk mặc định của Laravel để lưu file
DOCUMENT_STORAGE_DISK=local
# Disk lưu tài liệu của hệ thống, nếu project có cấu hình biến này
EMPLOYEE_DOCUMENT_STORAGE_DISK=local
# Disk lưu hồ sơ nhân viên, nếu module Employee sử dụng biến này
DOCUMENT_TEMPORARY_URL_MINUTES=5
# Thời hạn URL truy cập tài liệu tạm thời là 5 phút, nếu code có sử dụng biến này


# 1. ClamAV — Quét virus khi upload
DOCUMENT_CLAMAV_BINARY=clamscan
# Tên hoặc đường dẫn chương trình quét virus
DOCUMENT_CLAMAV_TIMEOUT_SECONDS=60
# Thời gian tối đa cho phép quét tài liệu: 60 giây
DOCUMENT_CLAMAV_DATABASE_DIRECTORY=/var/lib/clamav
# Thư mục chữ ký ClamAV trên Docker/VPS; phải có *.cvd hoặc *.cld và cho PHP worker đọc.
DOCUMENT_CLAMAV_MAX_SIGNATURE_AGE_HOURS=48
# Preflight production fail nếu chữ ký mới nhất cũ hơn giới hạn này.
EMPLOYEE_CLAMAV_BINARY=clamscan
# Chương trình quét virus cho file nhân viên
EMPLOYEE_CLAMAV_TIMEOUT_SECONDS=60
# Thời gian tối đa quét file nhân viên: 60 giây
EMPLOYEE_CLAMAV_DATABASE_DIRECTORY=/var/lib/clamav
# Trên Mac, có thể cài bằng:
#       brew install clamav
# Kiểm tra:
#      which clamscan
#      clamscan --version
# 2. Reconciliation — Đối soát file
DOCUMENT_RECONCILIATION_MAX_ITEMS=500
DOCUMENT_RECONCILIATION_MAX_SECONDS=30
DOCUMENT_RECONCILIATION_SCHEDULE_ENABLED=false
# Khi bật, scheduler tự đọc company active theo cursor; không phải liệt kê 1.000 company.
DOCUMENT_RECONCILIATION_COMPANIES_PER_RUN=25
DOCUMENT_RECONCILIATION_BATCH_MAX_SECONDS=240
# Reconciliation là quá trình đối chiếu dữ liệu tài liệu trong Database với file thực tế trong Storage.
# 3. Alert — Cảnh báo lỗi Storage
ALERT_DOCUMENT_STORAGE_FAILURES=5
# Cảnh báo khi lỗi Storage đạt ngưỡng 5
ALERT_DOCUMENT_STORAGE_SCANNER_FAILURES=1
# Cảnh báo khi có lỗi máy quét virus
ALERT_DOCUMENT_STORAGE_CLEANUP_FAILURES=1
# Cảnh báo khi dọn dẹp file thất bại
ALERT_DOCUMENT_STORAGE_SIGNED_URL_FAILURES=3
# Cảnh báo khi tạo URL truy cập tạm thời thất bại
ALERT_DOCUMENT_STORAGE_RECONCILIATION_ANOMALIES=1
# Cảnh báo khi phát hiện bất thường đối soát
VPS_MONITORING_ENABLED=false
VPS_MONITORING_BACKEND=
# Ví dụ prometheus; endpoint/credential không đưa vào browser hoặc tài liệu.
HORIZON_ENABLED=false
OPERATIONS_ALERT_CHANNEL=
# Chỉ khai tên channel canonical đã cấu hình; configured không đồng nghĩa delivery verified.
# Laravel upload file
#        ↓
# Supabase Storage gặp lỗi
#        ↓
# Ghi nhận storage failure
#        ↓
# Số lỗi đạt ngưỡng 5
#        ↓
# Kích hoạt cảnh báo
#        ↓
# Log / Email / Slack / Monitoring

# OPTIONAL private Supabase Storage adapter. Never expose these server-side
# credentials through VITE_* variables. The endpoint format is owned by the
# Supabase project, for example https://<project-ref>.supabase.co/storage/v1/s3.
# S3
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_STORAGE_BUCKET=laraveldji-media
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
DOCUMENT_STORAGE_DISK=supabase
EMPLOYEE_DOCUMENT_STORAGE_DISK=supabase
# PDF, hợp đồng , Excel, CSV , Hồ sơ nhân viên riêng tư , Lưu file tổng quát

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=390

# Bounded queue lifecycle used by the shipped Compose service:
# timeout=330s, memory=384MB, max-jobs=250, max-time=3600s.
# Docker restart policy owns clean worker replacement after a bounded exit.

CACHE_STORE=redis
LOCAL_MAIN_DATABASE=schema_admin
PROTECTED_DATABASE_NAMES=
REQUIRE_TESTING_DATABASE_SUFFIX=true
# Database routing contract:
# local/manual/demo = schema_admin
# PHPUnit/integration = schema_admin_testing (phpunit.xml)
# Playwright fixtures = schema_admin_browser_testing (explicit isolated process)
# production = DB_DATABASE supplied by the deployment environment
# historical development database = REMOVED / NO LONGER EXISTS
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# ENVIRONMENT_SPECIFIC / REQUIRED when Redis owns cache/queue/session
REDIS_HOST=127.0.0.1
# SECRET / OPTIONAL where provider authentication is enabled
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=schema_admin_
# Queue/session/lock state is durable and must not be evicted as disposable
# cache. The shipped shared Redis therefore uses noeviction; split cache into a
# separate Redis instance before introducing a cache eviction/maxmemory policy.

MAIL_MAILER=log
# ENVIRONMENT_SPECIFIC; production delivery remains unverified until provider smoke
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
# SECRET / OPTIONAL object-storage credential
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

# Employee avatar storage. Local/testing defaults to private local storage.
# Production may opt in to Cloudflare Images after the governed secret reference
# secret://media/cloudflare-images is configured by the deployment environment.
EMPLOYEE_AVATAR_DRIVER=cloudflare-images

CLOUDFLARE_IMAGES_ACCOUNT_ID=
# SECRET / OPTIONAL Cloudflare Images credential
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_HASH=

# ENVIRONMENT_SPECIFIC backup inputs are process-injected. BACKUP_DIRECTORY
# must be an absolute protected path and must not be committed.
# BACKUP_DIRECTORY=
# BACKUP_CONFIRM_DATABASE=

VITE_APP_NAME="${APP_NAME}"
VITE_SOURCEMAP=false
# nhớ Cấu hình trong Laravel + Vite  |  Trong vite.config.js: | false để không cho hiện: File .map có thể giúp DevTools hiển thị mã nguồn gốc khi debug.

# Laravel Reverb (WebSocket) Realtime
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_ENABLED=true
# cái này của REALTIME - ko có ko chạy
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# địa chỉ backend  |  dc app gọi api dc backend > config/cors.php | allowed_origins (Frontend nào được browser cho phép gọi tôi?) >
# VITE_API_URL=

# password : bcrypt, argon , argon2id > php artisan optimize:clear
HASH_DRIVER=argon2id

# A và B có một Webhook Secret mà attacker không biết:
# WEBHOOK_SECRET = abcXYZ123
# WEBHOOK_SECRET: không cần thêm vào .env theo kiến trúc hiện tại. Mỗi Integration Connection có secret riêng trong integration_connections.configuration.webhook_secret; runtime lấy tại [IntegrationHubService.php (line 124)](/Users/lahoathanh/Desktop/laraveldji/admin/Modules/Integration/app/Domain/Services/IntegrationHubService.php:124). Một secret toàn cục sẽ không phù hợp kiến trúc multi-company/provider.

# Google Cloud
GCP_PROJECT_ID=
GCP_SECRET_MANAGER_DEFAULT_VERSION=latest

# hệ thống tự động phát hiện DDOS
# CLOUDFLARE_TOKEN=
# CLOUDFLARE_TOKEN=tên cũ, project không sử dụng; có thể bỏ sau khi xác nhận token mới chạy tốt | sữ dụng : CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DDOS_MONITOR_ENABLED=true
CLOUDFLARE_DDOS_WINDOW_MINUTES=5
CLOUDFLARE_DDOS_EVENT_THRESHOLD=100
CLOUDFLARE_DDOS_TIMEOUT=10
# # tự động bật Sevirity > under attack mode
CLOUDFLARE_UNDER_ATTACK_AUTO_ENABLE=true

VITE_SOURCEMAP=false
# nhớ Cấu hình trong Laravel + Vite  |  Trong vite.config.js: | false để không cho hiện: File .map có thể giúp DevTools hiển thị mã nguồn gốc khi debug.
