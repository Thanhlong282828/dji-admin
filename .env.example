# REQUIRED = every runtime; SECRET = environment secret; ENVIRONMENT_SPECIFIC
# = deployment-owned; OPTIONAL = feature/provider opt-in; DERIVED = composed.
# Never commit populated secrets.
APP_NAME=Laravel
APP_ENV=local
# SECRET / REQUIRED
APP_KEY=
# Encryption |  Mã hóa 2 chiều
APP_DEBUG=false
# ENVIRONMENT_SPECIFIC / REQUIRED (HTTPS in production)
APP_URL=http://localhost

GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_LOGIN_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
PHONE_VERIFICATION_DRIVER=local
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

MEDIA_DRIVER=local
MEDIA_MAX_BYTES=8388608
CLOUDFLARE_IMAGES_TIMEOUT=15
# Production only: set an HTTPS origin and a distinct environment-owned database.
VPS_PRODUCTION_DATABASE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# Nó liên quan tới Maintenance Mode: php artisan down  | Laravel cần nơi lưu trạng thái kiểu: Website có đang maintenance không? |  thì maintenance state dùng cache store tên database theo cấu hình của app.
# Nó không có nghĩa website đang maintenance. Chỉ là cấu hình nơi Laravel sẽ dùng khi bạn thực sự chạy:   php artisan down    |   php artisan up   để mở lại.

# PHP_CLI_SERVER_WORKERS=4
# Cái này dành cho local khi chạy:     php artisan serve    |  Nó giúp local dev xử lý nhiều reques
# Production VPS dùng Nginx + PHP-FPM thì biến này về cơ bản không phải cấu hình worker production.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production containers default to stderr only; add daily explicitly only when
# local file retention is intentionally owned and monitored.
LOG_PRODUCTION_STACK=stderr
LOG_DAILY_DAYS=14
ERROR_TRACKING_ENABLED=false
HEALTH_RATE_LIMIT=120
BACKUP_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=90

DB_CONNECTION=mysql
# ENVIRONMENT_SPECIFIC / REQUIRED
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schema_admin
DB_USERNAME=root
# SECRET / REQUIRED outside passwordless local development
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=


# TLS/HTTPS= cài trên VPS | Trước đó DNS của domain phải trỏ đúng IP VPS và Nginx phải có site cho domain:
#     +
# Secure Cookie=SESSION_SECURE_COOKIE=true | → Cookie chỉ gửi qua HTTPS 🔒
#     +
# HttpOnly=SESSION_HTTP_ONLY=true | → JavaScript không được đọc session cookie
#     +
# SameSite=SESSION_SAME_SITE=lax | → hạn chế gửi cookie trong cross-site context
# Secure Cookie= yêu cầu COOKIE chỉ đi trên HTTPS 🔒
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DRIVER=database
# bài 7.12 Session & Cookie Security
SESSION_SECURE_COOKIE=false
# → chỉ gửi cookie qua HTTPS

SESSION_HTTP_ONLY=true
# → JavaScript không đọc session cookie

SESSION_SAME_SITE=lax
# → hạn chế cookie trong cross-site context

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=390

# Bounded queue lifecycle used by the shipped Compose service:
# timeout=330s, memory=384MB, max-jobs=250, max-time=3600s.
# Docker restart policy owns clean worker replacement after a bounded exit.

CACHE_STORE=redis
LOCAL_MAIN_DATABASE=schema_admin
PROTECTED_DATABASE_NAMES=
REQUIRE_TESTING_DATABASE_SUFFIX=true
# Database routing contract:
# local/manual/demo = schema_admin
# PHPUnit/integration = schema_admin_testing (phpunit.xml)
# Playwright fixtures = schema_admin_browser_testing (explicit isolated process)
# production = DB_DATABASE supplied by the deployment environment
# historical development database = REMOVED / NO LONGER EXISTS
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# ENVIRONMENT_SPECIFIC / REQUIRED when Redis owns cache/queue/session
REDIS_HOST=127.0.0.1
# SECRET / OPTIONAL where provider authentication is enabled
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=schema_admin_
# Queue/session/lock state is durable and must not be evicted as disposable
# cache. The shipped shared Redis therefore uses noeviction; split cache into a
# separate Redis instance before introducing a cache eviction/maxmemory policy.

MAIL_MAILER=log
# ENVIRONMENT_SPECIFIC; production delivery remains unverified until provider smoke
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
# SECRET / OPTIONAL object-storage credential
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

# Employee avatar storage. Local/testing defaults to private local storage.
# Production may opt in to Cloudflare Images after the governed secret reference
# secret://media/cloudflare-images is configured by the deployment environment.
EMPLOYEE_AVATAR_DRIVER=cloudflare-images

CLOUDFLARE_IMAGES_ACCOUNT_ID=
# SECRET / OPTIONAL Cloudflare Images credential
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_HASH=

# ENVIRONMENT_SPECIFIC backup inputs are process-injected. BACKUP_DIRECTORY
# must be an absolute protected path and must not be committed.
# BACKUP_DIRECTORY=
# BACKUP_CONFIRM_DATABASE=

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_ENABLED=true
# cái này của REALTIME - ko có ko chạy
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# địa chỉ backend  |  dc app gọi api dc backend > config/cors.php | allowed_origins (Frontend nào được browser cho phép gọi tôi?) >
# VITE_API_URL=

# password : bcrypt, argon , argon2id > php artisan optimize:clear
# HASH_DRIVER=argon2id

# A và B có một Webhook Secret mà attacker không biết:
# WEBHOOK_SECRET = abcXYZ123

# Google Cloud
GCP_PROJECT_ID=
GCP_SECRET_MANAGER_DEFAULT_VERSION=latest

# hệ thống tự động
CLOUDFLARE_TOKEN=
CLOUDFLARE_ZONE_ID=
