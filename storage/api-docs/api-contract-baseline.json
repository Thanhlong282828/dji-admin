            "name": "Organization",
            "description": "Tenant-scoped organization reads"
        },
        {
            "name": "Integration",
            "description": "Signed inbound integration boundary"
        },
        {
            "name": "Onboarding",
            "description": "Deprecated API bridge; use the CQRS web boundary"
        },
        {
            "name": "Performance",
            "description": "Legacy redirect bridge to the enterprise performance UI"
        },
        {
            "name": "Recruitment",
            "description": "Deprecated API bridge; use the CQRS web boundary"
        }
    ]
