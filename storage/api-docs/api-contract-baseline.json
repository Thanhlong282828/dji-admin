    "components": {
        "schemas": {
            "ValidationError": {
                "required": [
                    "message",
                    "errors"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "The given data was invalid."
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "CompanyCreateRequest": {
                "required": [
                    "code",
                    "name",
                    "country_code",
                    "timezone",
                    "currency_code",
                    "status"
                ],
                "properties": {
                    "code": {
                        "type": "string",
                        "example": "DEMO-COMPANY",
                        "maxLength": 30
                    },
                    "name": {
                        "type": "string",
                        "example": "Demo Company",
                        "maxLength": 255
                    },
                    "country_code": {
                        "type": "string",
                        "example": "VN",
                        "maxLength": 2
                    },
                    "timezone": {
                        "type": "string",
                        "example": "Asia/Ho_Chi_Minh",
                        "maxLength": 64
                    },
                    "currency_code": {
                        "type": "string",
                        "example": "VND",
                        "maxLength": 3
                    },
                    "status": {
                        "type": "string",
                        "example": "active",
                        "enum": [
                            "active",
                            "inactive"
                        ]
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "passport": {
                "type": "oauth2",
                "description": "OAuth 2.0 Authorization Code flow with PKCE. IAM and company scope remain enforced after OAuth scope validation.",
                "flows": {
                    "authorizationCode": {
                        "authorizationUrl": "/oauth/authorize",
                        "tokenUrl": "/oauth/token",
                        "refreshUrl": "/oauth/token",
                        "scopes": {
                            "company:read": "Đọc dữ liệu công ty",
                            "company:write": "Thay đổi dữ liệu công ty",
                            "organization:read": "Đọc cấu trúc tổ chức",
                            "onboarding:read": "Đọc onboarding",
                            "onboarding:write": "Thay đổi onboarding",
                            "performance:read": "Đọc hiệu suất",
                            "performance:write": "Thay đổi hiệu suất",
                            "recruitment:read": "Đọc tuyển dụng",
                            "recruitment:write": "Thay đổi tuyển dụng"
                        }
                    }
                }
            }
        }
    },
    "tags": [
