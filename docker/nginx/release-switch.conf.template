server {
    listen 8080;
    server_name _;

    location / {
        proxy_pass http://${RELEASE_UPSTREAM}:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Certification-Revision "${RELEASE_SWITCH_REVISION}" always;
    }
}
